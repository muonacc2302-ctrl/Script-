if typeof(hookmetamethod) == "function" and typeof(getnamecallmethod) == "function" then
    local old
    old = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = { ... }

        -- Ưu tiên Skill Aimbot của RJR khi bật SilentAimSkill và có _G.SilentAimTargetPos
        if not checkcaller() and _G.SilentAimSkill and _G.SilentAimTargetPos and (method == "FireServer" or method == "InvokeServer") then
            local sName = tostring(self)
            if sName == "RemoteEvent" or sName == "CommE" or sName == "RemoteFunction" then
                for i, v in pairs(args) do
                    if typeof(v) == "Vector3" then
                        args[i] = _G.SilentAimTargetPos
                    end
                end
                return old(self, unpack(args))
            end
        end

        -- Logic Silent Aim gốc của Capri
        local target = getgenv().Capri and getgenv().Capri.CurrentTarget
        if not checkcaller() and (method == "FireServer" or method == "InvokeServer") and target and (_G.SilentAim_Player or _G.SilentAim_NPC) then
            local pred = target.Position + (target.Velocity * _G.PredictionStrength)
            for i, v in pairs(args) do
                if typeof(v) == "Vector3" then
                    args[i] = pred
                elseif typeof(v) == "CFrame" then
                    args[i] = CFrame.new(v.Position, pred)
                end
            end
        end
        return old(self, unpack(args))
    end)
end

local lastAuraTick = 0
local espDrawings = {}
getgenv().CapriESPDrawings = espDrawings

RunService.RenderStepped:Connect(function()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

    -- Áp dụng tốc độ chạy khi bật Speed trong PVP
    if myHum and myHum.Health > 0 and _G.Speed_Active then
        myHum.WalkSpeed = _G.WalkSpeedValue
    end

    local originCenter = _G.ShowZone
        and Vector2.new(ZoneDragButton.AbsolutePosition.X + ZoneDragButton.AbsoluteSize.X / 2, ZoneDragButton.AbsolutePosition.Y + ZoneDragButton.AbsoluteSize.Y / 2)
        or Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    local shouldShowZone = (_G.ShowZone or _G.SilentAim_Player or _G.SilentAim_NPC) and not _G.Aim360
    FOVCircle.Visible = shouldShowZone
    FOVCircle.Radius = _G.FOV
    FOVCircle.Position = originCenter

    ZoneDragButton.Visible = _G.ShowZone and not _G.Aim360

    AimBtn.BackgroundColor3 = _G.SilentAim_Player and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(40, 40, 40)
    AimBtn.BackgroundTransparency = _G.SilentAim_Player and 0.2 or 0.5
    CamBtn.BackgroundTransparency = getgenv().Capri.LockEnabled and 0.2 or 0.5

    local currentTarget = getgenv().Capri.CurrentTarget
    if getgenv().Capri.LockEnabled and currentTarget then
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, currentTarget.Position), _G.Smoothness)
    end

    -- Đường line chỉ mục tiêu người chơi khi bật Silent Player
    local showSilentPlayerLine = false
    if _G.SilentAim_Player and currentTarget and currentTarget.Parent then
        local targetModel = currentTarget:FindFirstAncestorOfClass("Model")
        local targetPlr = targetModel and Players:GetPlayerFromCharacter(targetModel)
        local targetHum = targetModel and targetModel:FindFirstChildOfClass("Humanoid")
        if targetPlr and targetPlr ~= LocalPlayer and targetHum and targetHum.Health > 0 then
            local predWorldPos = currentTarget.Position + ((currentTarget.AssemblyLinearVelocity or currentTarget.Velocity or Vector3.zero) * (_G.PredictionStrength or 0.165))
            local screenPos, onScreen = Camera:WorldToViewportPoint(predWorldPos)
            if onScreen then
                local endPos = Vector2.new(screenPos.X, screenPos.Y)
                SilentAimLine.From = originCenter
                SilentAimLine.To = endPos
                SilentAimLine.Visible = true

                SilentAimDot.Position = endPos
                SilentAimDot.Visible = true
                showSilentPlayerLine = true
            end
        end
    end
    if not showSilentPlayerLine then
        SilentAimLine.Visible = false
        SilentAimDot.Visible = false
    end

    -- Hitbox Logic
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local distToMe = myRoot and (myRoot.Position - hrp.Position).Magnitude or 999

                if _G.SuperHB then
                    if distToMe <= _G.RenderDist then
                        hrp.Size = Vector3.new(_G.TruckHBSize, _G.TruckHBSize, _G.TruckHBSize)
                        hrp.Transparency = 0.4
                        hrp.CanCollide = false
                    else
                        hrp.Size = Vector3.new(2, 2, 1)
                        hrp.Transparency = 1
                        hrp.CanCollide = false
                    end
                elseif _G.HB then
                    if distToMe <= _G.RenderDist then
                        local minD, maxD = 4, 30
                        local alpha = math.clamp((distToMe - minD) / (maxD - minD), 0, 1)
                        local calculatedSize = _G.MinHBSize + (_G.MaxHBSize - _G.MinHBSize) * alpha

                        hrp.Size = Vector3.new(calculatedSize, calculatedSize, calculatedSize)
                        hrp.Transparency = 0.4
                        hrp.CanCollide = false
                    else
                        hrp.Size = Vector3.new(2, 2, 1)
                        hrp.Transparency = 1
                        hrp.CanCollide = false
                    end
                else
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                    hrp.CanCollide = false
                end
            end
        end
    end

    -- Kill Aura
    if _G.KA then
        if tick() - lastAuraTick >= 2.0 then
            lastAuraTick = tick()
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    local searchFolder = Workspace:FindFirstChild("Enemies") or Workspace
                    for _, obj in ipairs(searchFolder:GetDescendants()) do
                        if obj:IsA("Model") and obj ~= char then
                            local hum, hrp = obj:FindFirstChildOfClass("Humanoid"), obj:FindFirstChild("HumanoidRootPart")
                            if hum and hrp and hum.Health > 0 and (root.Position - hrp.Position).Magnitude <= 100 then
                                local isPlayer = Players:GetPlayerFromCharacter(obj) ~= nil
                                if not isPlayer then
                                    hum:TakeDamage(3387500)
                                else
                                    local pName = obj.Name
                                    if not getgenv().Capri.PlayerTimers[pName] then
                                        getgenv().Capri.PlayerTimers[pName] = tick()
                                    elseif tick() - getgenv().Capri.PlayerTimers[pName] >= 1.0 then
                                        hum:TakeDamage(50)
                                        getgenv().Capri.PlayerTimers[pName] = tick()
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    else
        getgenv().Capri.PlayerTimers = {}
    end

    -- ESP + Distance
    if _G.ESP then
        local activeDrawings = {}
        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local hrp = p.Character.HumanoidRootPart

                if hum and hum.Health > 0 then
                    local drawingObj = espDrawings[p]
                    if not drawingObj then
                        local box = Drawing.new("Square")
                        box.Color = Color3.fromRGB(0, 255, 128)
                        box.Thickness = 1.5
                        box.Filled = false

                        local nameTag = Drawing.new("Text")
                        nameTag.Color = Color3.fromRGB(255, 255, 255)
                        nameTag.Size = 14
                        nameTag.Center = true
                        nameTag.Outline = true

                        local line = Drawing.new("Line")
                        line.Color = Color3.fromRGB(0, 255, 128)
                        line.Thickness = 1
                        line.Transparency = 0.7

                        drawingObj = { box = box, name = nameTag, line = line }
                        espDrawings[p] = drawingObj
                    end

                    activeDrawings[p] = true
                    local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local size = Vector2.new(2500 / pos.Z, 3500 / pos.Z)
                        drawingObj.box.Size = size
                        drawingObj.box.Position = Vector2.new(pos.X - size.X / 2, pos.Y - size.Y / 2)
                        drawingObj.box.Visible = true

                        local distText = ""
                        if myRoot then
                            local distance = math.floor((myRoot.Position - hrp.Position).Magnitude)
                            distText = " [" .. distance .. "m]"
                        end

                        drawingObj.name.Text = p.Name .. " [" .. math.floor(hum.Health) .. " HP]" .. distText
                        drawingObj.name.Position = Vector2.new(pos.X, pos.Y - size.Y / 2 - 20)
                        drawingObj.name.Visible = true

                        drawingObj.line.From = screenCenter
                        drawingObj.line.To = Vector2.new(pos.X, pos.Y)
                        drawingObj.line.Visible = true
                    else
                        drawingObj.box.Visible = false
                        drawingObj.name.Visible = false
                        drawingObj.line.Visible = false
                    end
                end
            end
        end

        for p, obj in pairs(espDrawings) do
            if not activeDrawings[p] then
                obj.box:Remove()
                obj.name:Remove()
                obj.line:Remove()
                espDrawings[p] = nil
            end
        end
    else
        for _, obj in pairs(espDrawings) do
            obj.box:Remove()
            obj.name:Remove()
            obj.line:Remove()
        end
        espDrawings = {}
        getgenv().CapriESPDrawings = espDrawings
    end
end)
