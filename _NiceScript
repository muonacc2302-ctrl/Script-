    -- Hook Mouse Module (ReplicatedStorage.Mouse)
    local MouseModuleInstance = ReplicatedStorage:FindFirstChild("Mouse")
    local MouseModule = nil
    if MouseModuleInstance then
        pcall(function() MouseModule = require(MouseModuleInstance) end)
    end
    if MouseModule and typeof(MouseModule) == "table" then
        pcall(function()
            local realStore = { Hit = rawget(MouseModule, "Hit"), Target = rawget(MouseModule, "Target") }
            local mmt = getrawmetatable(MouseModule)
            if mmt then setreadonly(mmt, false) else mmt = {}; setmetatable(MouseModule, mmt) end
            rawset(MouseModule, "Hit", nil)
            rawset(MouseModule, "Target", nil)
            mmt.__index = function(_, key)
                if key == "Hit" then
                    if _G.SilentAimSkill and IsCurrentSkillEnabled() and rjrCurrentSilentAimTarget then
                        return CFrame.new(rjrCurrentSilentAimTarget.Position)
                    end
                    return realStore.Hit
                elseif key == "Target" then
                    if _G.SilentAimSkill and IsCurrentSkillEnabled() and rjrCurrentSilentAimTarget then
                        return rjrCurrentSilentAimTarget
                    end
                    return realStore.Target
                end
            end
            mmt.__newindex = function(_, key, value)
                if key == "Hit" or key == "Target" then
                    realStore[key] = value
                else
                    rawset(MouseModule, key, value)
                end
            end
            setreadonly(mmt, true)
        end)
    end

    -- Hook Mouse __index cho M1 R Aimbot
    local mouse = LocalPlayer:GetMouse()
    if typeof(hookmetamethod) == "function" then
        local oldIndex
        pcall(function()
            oldIndex = hookmetamethod(game, "__index", function(self, key)
                if not _G.SilentAimM1R or self ~= mouse then
                    return oldIndex(self, key)
                end
                if not rjrCurrentSilentAimTarget or not IsCurrentSkillEnabled() or checkcaller() then
                    return oldIndex(self, key)
                end
                local tp = rjrCurrentSilentAimTarget.Position
                local cp = Camera.CFrame.Position
                if key == "Hit" then
                    return CFrame.new(tp)
                elseif key == "Target" then
                    return rjrCurrentSilentAimTarget
                elseif key == "UnitRay" then
                    return Ray.new(cp, (tp - cp).Unit)
                elseif key == "Origin" then
                    return cp
                elseif key == "Direction" then
                    return (tp - cp).Unit
                end
                return oldIndex(self, key)
            end)
        end)
    end

