local function getSelectedPlayerTargetPart(myRoot, maxRange)
    local targetName = _G.SelectedAimPlayer or ""
    if targetName == "" then return nil end
    local plr = Players:FindFirstChild(targetName)
    if not plr or plr == LocalPlayer or not plr.Character then return nil end
    local hPart = plr.Character:FindFirstChild("HumanoidRootPart")
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if not hPart or not hum or hum.Health <= 0 then return nil end
    if myRoot and (hPart.Position - myRoot.Position).Magnitude > maxRange then
        return nil
    end
    return hPart
end

task.spawn(function()
    while task.wait(0.05) do
        local circleRadius = getCircleRadius()
        local use360 = is360Mode()
        _G.FOV = circleRadius

        local best, shortest = nil, use360 and (_G.MaxDist or 700) or circleRadius
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root then
            local playerAimRange = math.clamp(tonumber(_G.SilentAimPlayerRange) or 700, 0, 1000)

            -- Chế độ Aim Player chỉ định: chỉ aim đúng người chơi được chọn, không aim người khác trừ khi rời phạm vi aim
            if _G.AimSelectedPlayer_Active then
                best = getSelectedPlayerTargetPart(root, playerAimRange)
            else
                local candidates = {}
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then table.insert(candidates, p.Character) end
                end
                if Workspace:FindFirstChild("Enemies") then
                    for _, e in ipairs(Workspace.Enemies:GetChildren()) do table.insert(candidates, e) end
                end
                local zoneCenter = _G.ShowZone
                    and Vector2.new(ZoneDragButton.AbsolutePosition.X + ZoneDragButton.AbsoluteSize.X / 2, ZoneDragButton.AbsolutePosition.Y + ZoneDragButton.AbsoluteSize.Y / 2)
                    or Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

                local preferNearest = (_G.AimMode ~= "Tự aim")
                if preferNearest then
                    shortest = math.huge
                end

                for _, char in ipairs(candidates) do
                    local hPart = char:FindFirstChild("HumanoidRootPart")
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hPart and hum and hum.Health > 0 then
                        local mag = (hPart.Position - root.Position).Magnitude
                        local isNPC = Players:GetPlayerFromCharacter(char) == nil
                        local allowedDist = isNPC and (_G.MaxDist or 700) or playerAimRange
                        if mag <= allowedDist then
                            if (isNPC and _G.SilentAim_NPC) or (not isNPC and (_G.SilentAim_Player or _G.CamLock_Player)) then
                                if preferNearest then
                                    if mag < shortest then
                                        shortest, best = mag, hPart
                                    end
                                elseif use360 then
                                    if mag < shortest then shortest, best = mag, hPart end
                                else
                                    local sp, vis = Camera:WorldToViewportPoint(hPart.Position)
                                    if vis then
                                        local sd = (Vector2.new(sp.X, sp.Y) - zoneCenter).Magnitude
                                        if sd <= circleRadius and sd < shortest then shortest, best = sd, hPart end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        getgenv().Capri.CurrentTarget = best
    end
end)

