                        tweenToCFrame(tHRP.CFrame + Vector3.new(_G.TeleportOffsetX or 0, _G.TeleportOffsetY or 0, _G.TeleportOffsetZ or 0), _G.TweenSpeed)
                    end
                end)
            else
                stopTween()
            end
        end,
    })

    TeleportTab:Toggle({
        Title = "Lock 2",
        Value = _G.Lock2,
        Callback = function(v)
            _G.Lock2 = v
            if v then
                if (_G.SelectPly or "") == "" then
