        status.Parent = panel

        local info = Instance.new("TextLabel")
        info.BackgroundTransparency = 1
        info.Position = UDim2.new(0, 10, 0, 30)
        info.Size = UDim2.new(1, -20, 0, 16)
        info.Font = Enum.Font.Gotham
        info.TextSize = 11
        info.TextColor3 = Color3.fromRGB(190, 190, 200)
        info.TextXAlignment = Enum.TextXAlignment.Left
        info.Parent = panel

        local btn = Instance.new("TextButton")
        btn.Position = UDim2.new(0, 10, 1, -30)
        btn.Size = UDim2.new(1, -20, 0, 22)
        btn.BackgroundColor3 = Color3.fromRGB(45, 120, 70)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 12
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.Parent = panel
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

        LockHK.gui = sg
        LockHK.status = status
        LockHK.info = info
        LockHK.btn = btn
        btn.MouseButton1Click:Connect(function()
            if LockHK.active then stopHK() else startHK() end
        end)
        updateHKUI()
    end

    AimSec:Toggle({
        Title = "Hotkey Lock",
