local function applySavedButtonPositions(data)
    if type(data) ~= "table" then return end
    if type(data.CamBtnPos) == "table" then CamBtn.Position = UDim2.new(unpack(data.CamBtnPos)) end
    if type(data.AimBtnPos) == "table" then AimBtn.Position = UDim2.new(unpack(data.AimBtnPos)) end
    if type(data.JumpBtnPos) == "table" then JumpBtn.Position = UDim2.new(unpack(data.JumpBtnPos)) end
    if type(data.V4BtnPos) == "table" then V4Btn.Position = UDim2.new(unpack(data.V4BtnPos)) end
    if type(data.DashBtnPos) == "table" then DashBtn.Position = UDim2.new(unpack(data.DashBtnPos)) end
    if type(data.ZoneBtnPos) == "table" then ZoneDragButton.Position = UDim2.new(unpack(data.ZoneBtnPos)) end
end

