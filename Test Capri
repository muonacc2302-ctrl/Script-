    TeleportTab:Toggle({
        Title = "Tween TP to Player",
        Value = _G.TeleportPly,
        Callback = function(v)
            _G.TeleportPly = v
            if tpConn then tpConn:Disconnect(); tpConn = nil end
            if v and (_G.SelectPly or "") == "" then
                _G.TeleportPly = false
                notifyCapri("Teleport", "Select target player first", 2)
                return
            end
            if v then
                tpConn = RunService.Stepped:Connect(function()
                    if not _G.TeleportPly then return end
                    local tPlr = Players:FindFirstChild(_G.SelectPly or "")
                    local tHRP = tPlr and tPlr.Character and tPlr.Character:FindFirstChild("HumanoidRootPart")
