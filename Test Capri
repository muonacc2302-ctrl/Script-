    local function startHK()
        if LockHK.active then return end
        local part = activeAimPart or findAimbotPart()
        local model = part and part:FindFirstAncestorOfClass("Model")
        local plr = model and Players:GetPlayerFromCharacter(model)
        if not plr then
            notifyCapri("Hotkey Lock", "Select target player first", 2)
            return
