-- DỊCH CHUYỂN TAB
-- ==========================================
do
    local activeTw = nil
    local tpConn = nil
    local chaseConn = nil
    local chaseMode = nil

    local function cancelTw()
        if activeTw then pcall(function() activeTw:Cancel() end); activeTw = nil end
    end
    local function setCollide(on)
        local c = LocalPlayer.Character
        if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = on end
        end
    end
    local function goTween(cf, spd)
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end
        spd = math.clamp(tonumber(spd) or 180, 1, 500)
        local d = (cf.Position - hrp.Position).Magnitude
        cancelTw()
        setCollide(false)
        activeTw = TweenService:Create(hrp, TweenInfo.new(d / spd, Enum.EasingStyle.Linear), { CFrame = cf })
        activeTw:Play()
        activeTw.Completed:Connect(function() setCollide(true) end)
    end
    local function stopChase()
        chaseMode = nil
        if chaseConn then chaseConn:Disconnect(); chaseConn = nil end
        cancelTw()
    end
    local function startChase(mode)
        stopChase()
        chaseMode = mode
        chaseConn = RunService.Stepped:Connect(function()
            if not chaseMode then return end
            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not myHRP then return end
            local targetHRP = nil
            if chaseMode == "player" then
                local p = Players:FindFirstChild(_G.SelectPly or "")
                targetHRP = p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            elseif chaseMode == "nearest" then
                local best = math.huge
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local h = p.Character:FindFirstChild("HumanoidRootPart")
                        local hum = p.Character:FindFirstChildOfClass("Humanoid")
                        if h and hum and hum.Health > 0 then
                            local d = (h.Position - myHRP.Position).Magnitude
                            if d < best then best, targetHRP = d, h end
                        end
                    end
                end
            end
            if not targetHRP then return end
            local off = Vector3.new(_G.TeleportOffsetX or 0, _G.TeleportOffsetY or 0, _G.TeleportOffsetZ or 0)
            if (myHRP.Position - targetHRP.Position).Magnitude <= 70 then
                cancelTw()
                myHRP.AssemblyLinearVelocity = Vector3.zero
                myHRP.CFrame = targetHRP.CFrame + off
            else
                goTween(targetHRP.CFrame + off, _G.TweenSpeed)
            end
        end)
    end

    local pDrop = Tabs.Teleport:Dropdown({ Title = "Chọn người chơi mục tiêu", Values = getPlayerList(), Value = _G.SelectPly, Callback = function(v) _G.SelectPly = v or "" end })
    Tabs.Teleport:Button({ Title = "Làm mới danh sách người chơi", Callback = function()
        local lst = getPlayerList()
        if pDrop and pDrop.Refresh then pcall(function() pDrop:Refresh(lst, true) end) end
        notifyCapri("Dịch chuyển", "Đã làm mới danh sách", 1.5)
    end })
    Tabs.Teleport:Toggle({ Title = "Quan sát người chơi", Value = _G.SpectatePlys, Callback = function(v)
        _G.SpectatePlys = v
        if v and (_G.SelectPly or "") == "" then _G.SpectatePlys = false; notifyCapri("Dịch chuyển", "Hãy chọn người chơi trước", 2); return end
        if v then
            task.spawn(function()
                repeat
                    task.wait(0.1)
                    local p = Players:FindFirstChild(_G.SelectPly or "")
                    local h = p and p.Character and p.Character:FindFirstChildOfClass("Humanoid")
                    if not h or h.Health <= 0 then _G.SpectatePlys = false; break end
                    Camera.CameraSubject = h
                until not _G.SpectatePlys
                local mh = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if mh then Camera.CameraSubject = mh end
            end)
        end
    end })
    Tabs.Teleport:Toggle({ Title = "Bay mượt tới người chơi", Value = _G.TeleportPly, Callback = function(v)
        _G.TeleportPly = v
        if tpConn then tpConn:Disconnect(); tpConn = nil end
        if v and (_G.SelectPly or "") == "" then _G.TeleportPly = false; notifyCapri("Dịch chuyển", "Hãy chọn người chơi trước", 2); return end
        if v then
            tpConn = RunService.Stepped:Connect(function()
                if not _G.TeleportPly then return end
                local p = Players:FindFirstChild(_G.SelectPly or "")
                local r = p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                if r then goTween(r.CFrame + Vector3.new(_G.TeleportOffsetX or 0, _G.TeleportOffsetY or 0, _G.TeleportOffsetZ or 0), _G.TweenSpeed) end
            end)
        else
            cancelTw()
        end
    end })
    Tabs.Teleport:Toggle({ Title = "Bám mục tiêu (Lock 2)", Value = _G.Lock2, Callback = function(v)
        _G.Lock2 = v
        if v then
            if (_G.SelectPly or "") == "" then _G.Lock2 = false; notifyCapri("Dịch chuyển", "Hãy chọn người chơi trước", 2); return end
            _G.TweenNearest = false; startChase("player")
        else stopChase() end
        SaveCapriConfig()
    end })
    Tabs.Teleport:Toggle({ Title = "Bám người chơi gần nhất", Value = _G.TweenNearest, Callback = function(v)
        _G.TweenNearest = v
        if v then _G.Lock2 = false; startChase("nearest") else stopChase() end
        SaveCapriConfig()
    end })
    Tabs.Teleport:Slider({ Title = "Tốc độ bay (Tween Speed)", Step = 5, Value = { Min = 0, Max = 500, Default = _G.TweenSpeed }, Callback = Bind("TweenSpeed") })
    Tabs.Teleport:Input({ Title = "Độ lệch X", Value = tostring(_G.TeleportOffsetX), Callback = function(v) _G.TeleportOffsetX = math.clamp(tonumber(v) or 0, -3000, 3000); SaveCapriConfig() end })
    Tabs.Teleport:Input({ Title = "Độ lệch Y", Value = tostring(_G.TeleportOffsetY), Callback = function(v) _G.TeleportOffsetY = math.clamp(tonumber(v) or 0, -3000, 3000); SaveCapriConfig() end })
    Tabs.Teleport:Input({ Title = "Độ lệch Z", Value = tostring(_G.TeleportOffsetZ), Callback = function(v) _G.TeleportOffsetZ = math.clamp(tonumber(v) or 0, -3000, 3000); SaveCapriConfig() end })

    local points = World2 and {
        ["Mansion (Sea 2)"] = Vector3.new(-390, 332, 673),
        ["Phòng Swan"] = Vector3.new(2285, 15, 905),
        ["Trong tàu (Ship Inside)"] = Vector3.new(923, 126, 32852),
        ["Ngoài tàu (Ship Outside)"] = Vector3.new(-6509, 83, -133),
    } or (World3 and {
        ["Castle On The Sea"] = Vector3.new(-4999.45, 314.56, -3010.54),
        ["Floating Turtle"] = Vector3.new(-11352.54, 331.77, -10368.93),
        ["Mansion (Sea 3)"] = Vector3.new(-12592.93, 336.96, -7470.36),
        ["Hydra"] = Vector3.new(5404.45, 1004.13, 506.21),
    } or {})

    for name, pos in pairs(points) do
        Tabs.Teleport:Button({ Title = name, Icon = "map", Callback = function()
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                setCollide(false)
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.CFrame = CFrame.new(pos)
                task.delay(0.1, function() runCommF("requestEntrance", pos) end)
            end
        end })
    end
end

