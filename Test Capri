-- Logic Super Dash (~200m theo hướng nhìn)
local isDashing = false
local function doSuperDash()
    if isDashing then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    isDashing = true
    DashBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
    DashBtn.BackgroundTransparency = 0.2

    local camLook = Camera.CFrame.LookVector
    local flatDir = Vector3.new(camLook.X, 0, camLook.Z)
    if flatDir.Magnitude > 0.01 then
        flatDir = flatDir.Unit
    else
        flatDir = root.CFrame.LookVector
    end

    local totalDist = 200
    local steps = 10
    local stepDist = totalDist / steps

    task.spawn(function()
        for _ = 1, steps do
            if root and root.Parent then
                root.CFrame = root.CFrame + (flatDir * stepDist)
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
            task.wait(0.015)
        end
        isDashing = false
        if DashBtn then
            DashBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            DashBtn.BackgroundTransparency = 0.5
        end
    end)
end

DashBtn.MouseButton1Click:Connect(doSuperDash)

-- Logic nút Jump nổi
local jumpPower = 240
local repeatSpeed = 0.01
local holdingJump = false

local function doJump()
    local char = LocalPlayer.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if root and hum and hum.Health > 0 then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
            root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, jumpPower, root.AssemblyLinearVelocity.Z)
        end
    end
end

