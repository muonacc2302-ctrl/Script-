local function SaveConfig()
    if typeof(writefile) ~= "function" then return end
    pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(CollectConfig()))
    end)
end

local function LoadConfig()
    if typeof(isfile) ~= "function" or typeof(readfile) ~= "function" then return end
    local targetFile = nil
    if isfile(CONFIG_FILE) then
        targetFile = CONFIG_FILE
    elseif isfile(PREV_FILE) then
        targetFile = PREV_FILE
    elseif isfile(LEGACY_FILE) then
        targetFile = LEGACY_FILE
    end
    if not targetFile then return end

    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(targetFile))
    end)
    if ok and type(decoded) == "table" then
        for key in pairs(Defaults) do
            if decoded[key] ~= nil then
                _G[key] = decoded[key]
            end
        end
        applySavedButtonPositions(decoded)
    end
end

