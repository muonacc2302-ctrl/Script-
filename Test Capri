-- Nạp lại cấu hình nếu file đã có từ trước
do
    local okLoad, rawData = pcall(function()
        if typeof(isfile) == "function" and typeof(readfile) == "function" then
            if isfile(CONFIG_FILE) then
                return HttpService:JSONDecode(readfile(CONFIG_FILE))
            elseif isfile(PREV_FILE) then
                return HttpService:JSONDecode(readfile(PREV_FILE))
            elseif isfile(LEGACY_FILE) then
                return HttpService:JSONDecode(readfile(LEGACY_FILE))
            end
        end
        return nil
    end)
    if okLoad and type(rawData) == "table" then
