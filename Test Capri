local function getPlayerList()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(list, plr.Name)
        end
    end
    table.sort(list)
    return list
end

local function notifyCapri(title, content, duration)
    pcall(function()
        WindUI:Notify({
            Title = title,
            Content = content,
            Duration = duration or 2.5,
        })
    end)
end

-- ==========================================
-- BỔ SUNG MAIN: FRUIT M1, VOID FRUIT M1, AUTO HAKI/KEN/V3/FLEE
-- ==========================================
do
    local FruitAttackConnection = nil
    local VoidFruitM1Thread = nil
    local voidVec = Vector3.new(9e30, 9e30, 9e30)

    local function GetPlayerFruit()
        local char = LocalPlayer.Character
        if char then
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") and tool.ToolTip == "Blox Fruit" then
                    return tool
                end
            end
        end
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") and tool.ToolTip == "Blox Fruit" then
                    return tool
                end
            end
        end
        return nil
    end

    local function GetMaxCombo(tool)
        if not tool then return 5 end
        local n = tool.Name
        if n == "T-Rex-T-Rex" then return 4 end
        if n == "Blade-Blade" then return 2 end
        if n == "Pain-Pain" then return 4 end
        if n == "Control-Control" then return 4 end
        if n == "Gas-Gas" then return 5 end
        if n == "Dragon-Dragon" then
            local char = LocalPlayer.Character
            return (char and char:FindFirstChild("DragonHybrid")) and 5 or 3
        end
        return 5
    end

    local function SetFruitM1Enabled(enabled)
        if FruitAttackConnection then
            task.cancel(FruitAttackConnection)
            FruitAttackConnection = nil
        end
        if not enabled then return end
        FruitAttackConnection = task.spawn(function()
            while _G.FruitM1 do
                task.wait(0.1)
                local fruit = GetPlayerFruit()
                local remote = fruit and fruit:FindFirstChild("LeftClickRemote")
                local char = LocalPlayer.Character
                local myHRP = char and char:FindFirstChild("HumanoidRootPart")
                if not remote or not myHRP then continue end

                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character then
                        local tHRP = plr.Character:FindFirstChild("HumanoidRootPart")
                        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                        if tHRP and hum and hum.Health > 0 and (tHRP.Position - myHRP.Position).Magnitude < 500 then
                            local dir = (tHRP.Position - myHRP.Position).Unit
                            pcall(function()
                                remote:FireServer(Vector3.new(dir.X, dir.Y, dir.Z), 1, true)
                            end)
                        end
                    end
                end

                local enemies = Workspace:FindFirstChild("Enemies")
                if enemies then
                    for _, mob in ipairs(enemies:GetChildren()) do
                        local tHRP = mob:FindFirstChild("HumanoidRootPart")
                        local hum = mob:FindFirstChildOfClass("Humanoid")
                        if tHRP and hum and hum.Health > 0 and (tHRP.Position - myHRP.Position).Magnitude < 500 then
                            local dir = (tHRP.Position - myHRP.Position).Unit
                            pcall(function()
                                remote:FireServer(Vector3.new(dir.X, dir.Y, dir.Z), 1, true)
                            end)
                        end
                    end
                end
            end
        end)
    end

    local function SetVoidFruitM1Enabled(enabled)
        if VoidFruitM1Thread then
            task.cancel(VoidFruitM1Thread)
            VoidFruitM1Thread = nil
        end
        if not enabled then return end
        VoidFruitM1Thread = task.spawn(function()
            while _G.VoidFruitM1 do
                task.wait(0.3)
                local fruit = GetPlayerFruit()
                local remote = fruit and fruit:FindFirstChild("LeftClickRemote")
                if not remote then continue end
                local maxCombo = GetMaxCombo(fruit)
                pcall(function()
                    remote:FireServer(voidVec, maxCombo, true)
                end)
            end
        end)
    end

    if _G.FruitM1 then SetFruitM1Enabled(true) end
    if _G.VoidFruitM1 then SetVoidFruitM1Enabled(true) end

    uiControls.FruitM1 = MainTab:Toggle({
        Title = "Fruit M1",
        Value = _G.FruitM1,
        Callback = Bind("FruitM1", SetFruitM1Enabled),
    })

    uiControls.VoidFruitM1 = MainTab:Toggle({
        Title = "Void Fruit M1",
        Value = _G.VoidFruitM1,
        Callback = Bind("VoidFruitM1", SetVoidFruitM1Enabled),
    })

    -- Auto Haki
    task.spawn(function()
        local remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
        local commF = remotes and remotes:WaitForChild("CommF_", 5)
        while true do
            task.wait(2)
            if _G.AutoHaki and commF then
                local char = LocalPlayer.Character
                if char and not char:FindFirstChild("HasBuso") then
                    pcall(function() commF:InvokeServer("Buso") end)
                end
            end
        end
    end)

    -- Auto Ken (Silent)
    do
        local CollectionService = game:GetService("CollectionService")
        local Lighting = game:GetService("Lighting")
        local lastKenAt = 0
        task.spawn(function()
            while true do
                task.wait(1)
                if _G.AutoKen and tick() - lastKenAt >= 2 then
                    pcall(function()
                        local char = LocalPlayer.Character
                        local hum = char and char:FindFirstChildOfClass("Humanoid")
                        if not (char and hum and hum.Health > 0) then return end
                        if char:FindFirstChild("KenDisabled") then return end
                        if not CollectionService:HasTag(char, "Ken") then return end
                        local active = LocalPlayer:GetAttribute("KenActive")
                        if active == nil then active = char:GetAttribute("KenActive") end
                        if active == true then return end
                        local blur = Lighting:FindFirstChild("Blur")
                        if blur and blur.Enabled == true then return end
                        local commE = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommE")
                        if commE and commE:IsA("RemoteEvent") then
                            lastKenAt = tick()
                            commE:FireServer("Ken", true)
                        end
                    end)
                end
            end
        end)
    end

    -- Auto V3
    task.spawn(function()
        while true do
            task.wait(2)
            if _G.AutoV3 then
                local commE = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommE")
                if commE then
                    pcall(function() commE:FireServer("ActivateAbility") end)
                end
            end
        end
    end)

    -- Auto Flee / Raid
    local fleeThread = nil
    local fleeTriggered = false

    local function HasRaidChip()
        for _, cont in ipairs({ LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack") }) do
            if cont then
                for _, t in ipairs(cont:GetChildren()) do
                    if t:IsA("Tool") then
                        local n = string.lower(t.Name)
                        if string.find(n, "chip", 1, true) or string.find(n, "micro", 1, true) then
                            return true
                        end
                    end
                end
            end
        end
        return false
    end

    local function EnsureRaidChip()
        if HasRaidChip() then return true end
        local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if not commF then return false end
        local ok, list = pcall(function() return commF:InvokeServer("GetFruits") end)
        if ok and type(list) == "table" then
            local candidates = {}
            for _, v in ipairs(list) do
                if type(v) == "table" and type(v.Name) == "string" and type(v.Price) == "number" and v.Price < 1000000 then
                    candidates[#candidates + 1] = v
                end
            end
            table.sort(candidates, function(a, b) return a.Price < b.Price end)
            for _, cand in ipairs(candidates) do
                local okLoad, loaded = pcall(function() return commF:InvokeServer("LoadFruit", cand.Name) end)
                if okLoad and loaded == true then
                    task.wait(0.4)
                    break
                end
            end
        end
        pcall(function() commF:InvokeServer("RaidsNpc", "Select", _G.RaidChip or "Flame") end)
        return HasRaidChip()
    end

    local function TriggerRaid()
        local map = Workspace:FindFirstChild("Map")
        if not map then return "nobutton" end
        local btn
        if World3 then
            local holder = map:FindFirstChild("Boat Castle")
            btn = holder and holder:FindFirstChild("RaidSummon2")
        elseif World2 then
            local holder = map:FindFirstChild("CircleIsland")
            btn = holder and holder:FindFirstChild("RaidSummon2")
        end
        if not btn then return "nobutton" end
        btn = btn:FindFirstChild("Button") or btn:FindFirstChild("Main") or btn
        local detector = btn:FindFirstChild("ClickDetector")
        if detector and fireclickdetector then
            pcall(fireclickdetector, detector)
            return true
        end
        local prompt = btn:FindFirstChild("ProximityPrompt")
        if prompt and fireproximityprompt then
            pcall(fireproximityprompt, prompt)
            return true
        end
        return false
    end

    local function StartAutoFlee()
        if fleeThread then return end
        fleeThread = task.spawn(function()
            pcall(EnsureRaidChip)
            while _G.AutoFlee do
                task.wait(0.2)
                pcall(function()
                    local char = LocalPlayer.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if not hum or hum.Health <= 0 or hum.MaxHealth <= 0 then return end
                    local hpPct = (hum.Health / hum.MaxHealth) * 100
                    if hpPct <= (_G.AutoFleeHP or 30) then
                        if not fleeTriggered then
                            fleeTriggered = true
                            local okChip = HasRaidChip() or EnsureRaidChip()
                            local res = okChip and TriggerRaid() or "nochip"
                            if res == true then
                                notifyCapri("Auto Flee / Raid", "Summoning Raid", 3)
                                task.delay(8, function()
                                    if _G.AutoFlee then pcall(EnsureRaidChip) end
                                end)
                            elseif res == "nobutton" then
                                notifyCapri("Auto Flee / Raid", "Raid summon button not found", 3)
                            elseif res == "nochip" then
                                notifyCapri("Auto Flee / Raid", "No raid chip", 3)
                            else
                                notifyCapri("Auto Flee / Raid", "Failed to summon raid", 3)
                            end
                        end
                    else
                        fleeTriggered = false
                    end
                end)
            end
            fleeThread = nil
            fleeTriggered = false
        end)
    end

    local function StopAutoFlee()
        if fleeThread then
            pcall(task.cancel, fleeThread)
            fleeThread = nil
        end
        fleeTriggered = false
    end

    if _G.AutoFlee then StartAutoFlee() end

    uiControls.AutoHaki = MainTab:Toggle({ Title = "Auto Haki", Value = _G.AutoHaki, Callback = Bind("AutoHaki") })
    uiControls.AutoKen = MainTab:Toggle({ Title = "Auto Ken (Silent)", Value = _G.AutoKen, Callback = Bind("AutoKen") })
    uiControls.AutoV3 = MainTab:Toggle({ Title = "Auto V3", Value = _G.AutoV3, Callback = Bind("AutoV3") })
    uiControls.AutoFlee = MainTab:Toggle({
        Title = "Auto Flee / Raid",
        Value = _G.AutoFlee,
        Callback = Bind("AutoFlee", function(v)
            if v then StartAutoFlee() else StopAutoFlee() end
        end),
    })
    uiControls.AutoFleeHP = MainTab:Slider({
        Title = "Flee HP Threshold (%)",
        Step = 1,
        Value = { Min = 1, Max = 100, Default = _G.AutoFleeHP },
        Callback = Bind("AutoFleeHP"),
    })
end

-- ==========================================
-- BỔ SUNG PVP: AIMBOT RANGE, AIMBOT SETTINGS, HOTKEY LOCK
-- ==========================================
do
    local LastSkillPressed = "Z"
    UserInputService.InputBegan:Connect(function(input)
        if UserInputService:GetFocusedTextBox() then return end
        local keyMap = {
            [Enum.KeyCode.Z] = "Z",
            [Enum.KeyCode.X] = "X",
            [Enum.KeyCode.C] = "C",
            [Enum.KeyCode.V] = "V",
            [Enum.KeyCode.F] = "F",
        }
        if keyMap[input.KeyCode] then
            LastSkillPressed = keyMap[input.KeyCode]
        end
    end)

    local function isCurrentSkillEnabled()
        local skills = _G.SilentAimSkills
        if type(skills) ~= "table" or next(skills) == nil then return true end
        if skills[LastSkillPressed] ~= nil then return skills[LastSkillPressed] == true end
        for _, v in pairs(skills) do
            if v == LastSkillPressed then return true end
        end
        return false
    end

    local function getOriginPoint()
        local pos = UserInputService:GetMouseLocation()
        if _G.SilentAimFOVMode == "屏幕中心" or pos.X <= 0 or pos.Y <= 0 then
            local vp = Camera.ViewportSize
            return Vector2.new(vp.X / 2, vp.Y / 2)
        end
        return pos
    end

    local function isAliveChar(char)
        if not char then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        return hum ~= nil and hum.Health > 0
    end

    local function isEnemyPlayer(plr)
        if not plr or plr == LocalPlayer then return false end
        local frame = LocalPlayer:FindFirstChild("PlayerGui")
            and LocalPlayer.PlayerGui:FindFirstChild("Main")
            and LocalPlayer.PlayerGui.Main:FindFirstChild("Allies")
            and LocalPlayer.PlayerGui.Main.Allies:FindFirstChild("Container")
            and LocalPlayer.PlayerGui.Main.Allies.Container:FindFirstChild("Allies")
            and LocalPlayer.PlayerGui.Main.Allies.Container.Allies:FindFirstChild("ScrollingFrame")
            and LocalPlayer.PlayerGui.Main.Allies.Container.Allies.ScrollingFrame:FindFirstChild("Frame")
        if frame and frame:FindFirstChild(plr.Name) then return false end
        if LocalPlayer.Team and plr.Team and LocalPlayer.Team.Name == "Marines" and plr.Team.Name == "Marines" then
            return false
        end
        return true
    end

    local SafeZones = {
        { pos = Vector3.new(-3000, 250, 2057), radius = 700 },
        { pos = Vector3.new(1101, 16, 1446), radius = 400 },
        { pos = Vector3.new(-12, 29, 2840), radius = 200 },
        { pos = Vector3.new(-376, 149, 307), radius = 150 },
        { pos = Vector3.new(-6437, 306, -4730), radius = 150 },
        { pos = Vector3.new(-338, 21, 5539), radius = 200 },
        { pos = Vector3.new(-12550, 337, -7506), radius = 400 },
        { pos = Vector3.new(-5046, 315, -2993), radius = 300 },
        { pos = Vector3.new(-16228, 9, 443), radius = 300 },
    }

    local function isSafeZonePlayer(plr)
        if not plr or not plr.Character then return false end
        if plr:GetAttribute("SafeZone") == true or plr:GetAttribute("InSafeZone") == true then return true end
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        for _, z in ipairs(SafeZones) do
            if (hrp.Position - z.pos).Magnitude <= z.radius then return true end
        end
        return false
    end

    local function passAimFilters(plr)
        if _G.SilentAimTeamCheck and not isEnemyPlayer(plr) then return false end
        if _G.SilentAimExcludePVP and plr:GetAttribute("PvpDisabled") == true then return false end
        if _G.SilentAimExcludeSafeZone and isSafeZonePlayer(plr) then return false end
        return true
    end

    local function findAimbotPart()
        local method = _G.SilentAimMethod or "鼠标最近的玩家"
        local partName = _G.SilentAimPart or "Head"

        if method == "选择玩家" then
            if not _G.SilentAimTargetPlayers then return nil end
            local plr = Players:FindFirstChild(_G.SilentAimSelectedPlayer or "")
            if not plr or plr == LocalPlayer or not passAimFilters(plr) or not isAliveChar(plr.Character) then return nil end
            return plr.Character:FindFirstChild(partName) or plr.Character:FindFirstChild("HumanoidRootPart")
        end

        if method == "最近的玩家" then
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not myRoot then return nil end
            local best, bestDist = nil, math.huge
            local function check(char)
                if not isAliveChar(char) then return end
                local p = char:FindFirstChild(partName) or char:FindFirstChild("HumanoidRootPart")
                if not p then return end
                local d = (p.Position - myRoot.Position).Magnitude
                if d < bestDist then best, bestDist = p, d end
            end
            if _G.SilentAimTargetPlayers then
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and passAimFilters(plr) then check(plr.Character) end
                end
            end
            if _G.SilentAimTargetMobs and Workspace:FindFirstChild("Enemies") then
                for _, mob in ipairs(Workspace.Enemies:GetChildren()) do check(mob) end
            end
            return best
        end

        local origin = getOriginPoint()
        local best, bestDist = nil, _G.SilentAimFOV or 150
        local function checkScreen(char)
            if not isAliveChar(char) then return end
            local p = char:FindFirstChild(partName) or char:FindFirstChild("HumanoidRootPart")
            if not p then return end
            local scr, onScreen = Camera:WorldToViewportPoint(p.Position)
            if onScreen then
                local d = (Vector2.new(scr.X, scr.Y) - origin).Magnitude
                if d <= bestDist then best, bestDist = p, d end
            end
        end
        if _G.SilentAimTargetPlayers then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and passAimFilters(plr) then checkScreen(plr.Character) end
            end
        end
        if _G.SilentAimTargetMobs and Workspace:FindFirstChild("Enemies") then
            for _, mob in ipairs(Workspace.Enemies:GetChildren()) do checkScreen(mob) end
        end
        return best
    end

    local rjrFovCircle, rjrAimLine
    pcall(function()
        rjrFovCircle = Drawing.new("Circle")
        rjrFovCircle.Visible = false
        rjrFovCircle.Filled = false
        rjrFovCircle.Thickness = 2
        rjrFovCircle.Color = Color3.fromRGB(unpack(_G.SilentAimFOVColor))
        rjrFovCircle.Radius = _G.SilentAimFOV
        getgenv().CapriRJRFOVCircle = rjrFovCircle

        rjrAimLine = Drawing.new("Line")
        rjrAimLine.Visible = false
        rjrAimLine.Thickness = 2
        rjrAimLine.Color = Color3.fromRGB(255, 0, 0)
        getgenv().CapriRJRSilentLine = rjrAimLine
    end)

    local activeAimPart = nil
    local mouse = LocalPlayer:GetMouse()

    if typeof(hookmetamethod) == "function" then
        pcall(function()
            local prevIndex
            prevIndex = hookmetamethod(game, "__index", function(self, key)
                if not checkcaller() and _G.SilentAimM1R and self == mouse and activeAimPart and isCurrentSkillEnabled() then
                    local tp = activeAimPart.Position
                    local cp = Camera.CFrame.Position
                    if key == "Hit" then
                        return CFrame.new(tp)
                    elseif key == "Target" then
                        return activeAimPart
                    elseif key == "UnitRay" then
                        return Ray.new(cp, (tp - cp).Unit)
                    elseif key == "Origin" then
                        return cp
                    elseif key == "Direction" then
                        return (tp - cp).Unit
                    end
                end
                return prevIndex(self, key)
            end)
        end)
    end

    RunService.RenderStepped:Connect(function()
        local origin = getOriginPoint()
        if rjrFovCircle then
            pcall(function()
                rjrFovCircle.Visible = _G.SilentAimShowFOV == true
                rjrFovCircle.Radius = _G.SilentAimFOV or 150
                rjrFovCircle.Position = origin
            end)
        end

        if _G.SilentAimM1R or _G.SilentAimSkill or _G.SilentAimShowLine then
            activeAimPart = findAimbotPart()
            if _G.SilentAimSkill and activeAimPart and isCurrentSkillEnabled() then
                _G.SilentAimTargetPos = activeAimPart.Position
            else
                _G.SilentAimTargetPos = nil
            end
        else
            activeAimPart = nil
            _G.SilentAimTargetPos = nil
        end

        if rjrAimLine then
            pcall(function()
                if _G.SilentAimShowLine and activeAimPart then
                    local scr, onScreen = Camera:WorldToViewportPoint(activeAimPart.Position)
                    if onScreen then
                        rjrAimLine.From = origin
                        rjrAimLine.To = Vector2.new(scr.X, scr.Y)
                        rjrAimLine.Visible = true
                        return
                    end
                end
                rjrAimLine.Visible = false
            end)
        end
    end)

    local RangeSec = PvpTab:Section({ Title = "Aimbot Range Settings" })
    RangeSec:Toggle({ Title = "Show FOV", Value = _G.SilentAimShowFOV, Callback = Bind("SilentAimShowFOV") })
