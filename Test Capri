                pcall(function()
                    local wb = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("WaterBase-Plane")
                    if wb then wb.Size = Vector3.new(1000, 80, 1000) end
                end)
            end
        end),
    })

    MiscTab:Toggle({
        Title = "Remove Water Surface",
        Value = _G.RemoveWater,
        Callback = Bind("RemoveWater", function(v)
            if removeWaterThread then task.cancel(removeWaterThread); removeWaterThread = nil end
            if v then
                removeWaterThread = task.spawn(function()
                    while _G.RemoveWater do
                        pcall(function()
                            local wb = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("WaterBase-Plane")
                            if wb then wb:Destroy() end
                        end)
                        task.wait(5)
                    end
                end)
            end
        end),
    })

    MiscTab:Toggle({
        Title = "Unlock FPS (PC)",
        Value = false,
        Callback = function(v)
            if v and setfpscap then pcall(setfpscap, 999) end
        end,
    })

    MiscTab:Toggle({
        Title = "Left-Click Dash",
        Value = _G.ClickJump,
        Callback = Bind("ClickJump", function(v)
            if clickJumpConn then clickJumpConn:Disconnect(); clickJumpConn = nil end
            if v then
                clickJumpConn = UserInputService.InputBegan:Connect(function(inp, gp)
                    if gp or not _G.ClickJump or inp.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and Camera then
                        local ok, ray = pcall(function() return Camera:ViewportPointToRay(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y) end)
                        if ok and ray and ray.Direction.Magnitude > 0.001 then
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.CFrame = CFrame.new(hrp.Position + ray.Direction.Unit * 300)
                        end
                    end
                end)
            end
        end),
    })

    MiscTab:Toggle({
        Title = "Mob Gather",
        Value = _G.BringMobs,
        Callback = Bind("BringMobs", function(v)
            if bringMobsConn then bringMobsConn:Disconnect(); bringMobsConn = nil end
            if v then
                bringMobsConn = RunService.Heartbeat:Connect(function()
                    if not _G.BringMobs then return end
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local enemies = Workspace:FindFirstChild("Enemies")
                    if not hrp or not enemies then return end
                    pcall(function()
                        if sethiddenproperty then sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge) end
                        local feet = hrp.Position - Vector3.new(0, 17, 0)
                        for _, mob in ipairs(enemies:GetChildren()) do
                            local mHRP = mob:FindFirstChild("HumanoidRootPart")
                            local mHum = mob:FindFirstChildOfClass("Humanoid")
                            if mHRP and mHum and mHum.Health > 0 and (mHRP.Position - feet).Magnitude <= 500 then
                                mHum.WalkSpeed = 0
                                mHRP.CanCollide = false
                                mHRP.CFrame = CFrame.new(feet)
                            end
                        end
                    end)
                end)
            end
        end),
    })

    MiscTab:Toggle({
        Title = "Auto Soru",
        Value = _G.AutoSoru,
        Callback = Bind("AutoSoru", function(v)
            if soruThread then task.cancel(soruThread); soruThread = nil end
            if v then
                soruThread = task.spawn(function()
                    while _G.AutoSoru do
                        pcall(function()
                            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            if not myRoot then return end
                            local closest, bestD = nil, math.huge
                            for _, plr in ipairs(Players:GetPlayers()) do
                                if plr ~= LocalPlayer and plr.Character then
                                    local r = plr.Character:FindFirstChild("HumanoidRootPart")
                                    local h = plr.Character:FindFirstChildOfClass("Humanoid")
                                    if r and h and h.Health > 0 then
                                        local d = (r.Position - myRoot.Position).Magnitude
                                        if d < bestD then bestD, closest = d, r end
                                    end
                                end
                            end
                            if closest then
                                local targetPos = (closest.CFrame * CFrame.new(0, 0, 3)).Position
                                local startCF = myRoot.CFrame
                                local endCF = (startCF - startCF.Position) + targetPos + Vector3.new(0, myRoot.Size.Y * 1.5, 0)
                                ReplicatedStorage.Remotes.CommE:FireServer("Soru", startCF, endCF, Workspace:GetServerTimeNow(), math.random(1, 999999999))
                            end
                        end)
                        task.wait(1)
                    end
                end)
            end
        end),
    })
end

-- ==========================================
-- BỔ SUNG SERVER & SETTINGS TAB
-- ==========================================
do
    local function setPlayerRange(label)
        _G.HopPlayerRange = label
        local a, b = label:match("(%d+)%-(%d+)")
        _G.HopMinPlayers = tonumber(a) or 1
        _G.HopMaxPlayers = tonumber(b) or 12
    end

    local function setBountyRange(label)
        _G.HopBountyRange = label
        local numStr, unit = label:match("大于([%d%.]+)([Mm]?)")
        local val = tonumber(numStr) or 3
        if unit and unit:lower() == "m" then val = val * 1000000 end
        _G.HopMinBounty = val + 1
        _G.HopMaxBounty = 999999999
    end

    setPlayerRange(_G.HopPlayerRange)
    setBountyRange(_G.HopBountyRange)

    ServerTab:Button({
        Title = "Rejoin Server",
        Callback = function()
            pcall(function()
                ReplicatedStorage:WaitForChild("__ServerBrowser"):InvokeServer("teleport", game.JobId)
            end)
        end,
    })

    ServerTab:Dropdown({
        Title = "Select Server Region",
        Values = { "Singapore", "Oregon", "Florida", "Texas", "California", "Hong Kong", "Germany", "Brazil" },
        Value = _G.ServerRegion,
        Callback = function(v) _G.ServerRegion = v; SaveConfig() end,
    })

    ServerTab:Dropdown({
        Title = "Select Players",
        Values = { "1-12", "3-12", "5-12", "7-12", "9-12" },
        Value = _G.HopPlayerRange,
        Callback = function(v) setPlayerRange(v); SaveConfig() end,
    })

    ServerTab:Dropdown({
        Title = "Select Bounty",
        Values = { "大于3m", "大于5m", "大于10m", "大于15m", "大于25m", "大于35m", "大于50m" },
        Value = _G.HopBountyRange,
        Callback = function(v) setBountyRange(v); SaveConfig() end,
    })

    ServerTab:Button({
        Title = "Server Hop",
        Icon = "wind",
        Callback = function()
            if getgenv().CapriHopping then return end
            getgenv().CapriHopping = true
            notifyCapri("Server Hop", "Searching server...", 4)
            task.spawn(function()
                local browser = ReplicatedStorage:FindFirstChild("__ServerBrowser")
                if not browser then
                    getgenv().CapriHopping = false
                    return
                end
                for page = 1, 50 do
                    local ok, list = pcall(function() return browser:InvokeServer(page) end)
                    if ok and type(list) == "table" then
                        for jobId, info in pairs(list) do
                            if jobId ~= game.JobId and type(info) == "table" then
                                local reg = tostring(info.Region or "")
                                local cnt = tonumber(info.Count) or 0
                                local bty = tonumber(info.Bounty) or 0
                                local regOk = (_G.ServerRegion == "" or reg:lower():find(tostring(_G.ServerRegion):lower(), 1, true) ~= nil)
                                if regOk and cnt >= _G.HopMinPlayers and cnt <= _G.HopMaxPlayers and bty >= _G.HopMinBounty and bty <= _G.HopMaxBounty then
                                    pcall(function() browser:InvokeServer("teleport", jobId) end)
                                    task.wait(2)
                                    getgenv().CapriHopping = false
                                    return
                                end
                            end
                        end
                    end
                    task.wait(0.05)
                end
                getgenv().CapriHopping = false
                notifyCapri("Server Hop", "No matching server found", 3)
            end)
        end,
    })

    ServerTab:Paragraph({
        Title = "Server ID",
        Desc = tostring(game.JobId),
        Buttons = {
            {
                Title = "Copy",
                Callback = function()
                    if setclipboard then pcall(setclipboard, tostring(game.JobId)) end
                    notifyCapri("Server ID", "Copied current JobId", 2)
                end,
            },
        },
    })

    ServerTab:Input({
        Title = "Enter Server ID",
        Value = tostring(_G.JobId or ""),
        Callback = function(v) _G.JobId = v; SaveConfig() end,
    })

    ServerTab:Button({
        Title = "Join Server ID",
        Callback = function()
            if not _G.JobId or _G.JobId == "" then
                notifyCapri("Server ID", "Enter Server ID first", 2)
                return
            end
            pcall(function()
                ReplicatedStorage:WaitForChild("__ServerBrowser"):InvokeServer("teleport", _G.JobId)
            end)
        end,
    })

    local availableThemes = WindUI:GetThemes()
    local themeNames = {}
    for k in pairs(availableThemes) do table.insert(themeNames, k) end

    SettingsTab:Keybind({
        Title = "Toggle Window Key",
        Value = _G.ToggleKey,
        Callback = function(v)
            _G.ToggleKey = tostring(v)
            if Enum.KeyCode[_G.ToggleKey] then
                pcall(function() Window:SetToggleKey(Enum.KeyCode[_G.ToggleKey]) end)
            end
            SaveConfig()
        end,
    })

    SettingsTab:Dropdown({
        Title = "Select Theme",
        Values = themeNames,
        Value = _G.Theme,
        Callback = function(v)
            _G.Theme = v
            pcall(function() WindUI:SetTheme(v) end)
            SaveConfig()
        end,
    })

    SettingsTab:Button({
        Title = "Save Config",
        Callback = function()
            SaveConfig()
            notifyCapri("Settings", "Config saved!", 2)
        end,
    })

    SettingsTab:Button({
        Title = "Load Config",
        Callback = function()
            LoadConfig()
            notifyCapri("Settings", "Config loaded!", 2)
        end,
    })
end
