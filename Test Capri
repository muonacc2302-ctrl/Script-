local function rjrHexToColor3(hex)
    hex = tostring(hex or "FFFFFF"):gsub("#", "")
    local r = (tonumber(hex:sub(1, 2), 16) or 255) / 255
    local g = (tonumber(hex:sub(3, 4), 16) or 255) / 255
    local b = (tonumber(hex:sub(5, 6), 16) or 255) / 255
    return Color3.new(r, g, b)
end

local function rjrSaveHexColor(key, color)
    _G[key] = string.format(
        "%02X%02X%02X",
        math.floor(color.R * 255 + 0.5),
        math.floor(color.G * 255 + 0.5),
        math.floor(color.B * 255 + 0.5)
    )
    SaveConfig()
end

