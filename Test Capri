local uiControls = {}
local function setUI(key, val)
    local c = uiControls[key]
    if c and type(c.Set) == "function" then
        c._syncing = true
        pcall(function() c:Set(val) end)
        c._syncing = false
    end
end

local function Bind(key, cb)
    return function(val)
        local c = uiControls[key]
        _G[key] = val
        if not (c and c._syncing) and type(cb) == "function" then
            cb(val)
        end
        SaveCapriConfig()
    end
end

