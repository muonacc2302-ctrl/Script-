do
    local ActiveTween = nil
    local tpConn = nil
    local chaseConn = nil
    local chaseMode = nil

    local function stopTween()
        if ActiveTween then
            pcall(function() ActiveTween:Cancel() end)
            ActiveTween = nil
        end
    end

    local function setCharNoCollide(on)
        local char = LocalPlayer.Character
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = not on
            end
        end
    end

    local function tweenToCFrame(targetCF, speed)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end
        local spd = math.clamp(tonumber(speed) or 180, 1, 500)
        local dist = (targetCF.Position - hrp.Position).Magnitude
        if ActiveTween then pcall(function() ActiveTween:Cancel() end) end
        setCharNoCollide(true)
        ActiveTween = game:GetService("TweenService"):Create(hrp, TweenInfo.new(dist / spd, Enum.EasingStyle.Linear), { CFrame = targetCF })
        ActiveTween:Play()
        ActiveTween.Completed:Connect(function()
            setCharNoCollide(false)
        end)
    end

    local function stopChase()
        chaseMode = nil
        if chaseConn then chaseConn:Disconnect(); chaseConn = nil end
        stopTween()
    end

    local function startChase(mode)
        stopChase()
        chaseMode = mode
        chaseConn = RunService.Stepped:Connect(function()
            if not chaseMode then return end
            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not myHRP then return end
            local targetHRP = nil
            if chaseMode == "player" then
                local plr = Players:FindFirstChild(_G.SelectPly or "")
                targetHRP = plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            elseif chaseMode == "nearest" then
                local best = math.huge
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character then
                        local h = plr.Character:FindFirstChild("HumanoidRootPart")
                        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                        if h and hum and hum.Health > 0 then
                            local d = (h.Position - myHRP.Position).Magnitude
                            if d < best then best, targetHRP = d, h end
                        end
                    end
                end
            end
            if not targetHRP then return end
            local offset = Vector3.new(_G.TeleportOffsetX or 0, _G.TeleportOffsetY or 0, _G.TeleportOffsetZ or 0)
            local dist = (myHRP.Position - targetHRP.Position).Magnitude
            if dist <= 70 then
                stopTween()
                myHRP.AssemblyLinearVelocity = Vector3.zero
                myHRP.CFrame = targetHRP.CFrame + offset
            else
                tweenToCFrame(targetHRP.CFrame + offset, _G.TweenSpeed)
            end
        end)
    end

    local plrDrop = TeleportTab:Dropdown({
        Title = "Select Target Player",
        Values = getPlayerList(),
        Value = _G.SelectPly,
        Callback = function(v)
            _G.SelectPly = v or ""
