            return lib
        end
    end

    local ok, lib = pcall(function()
        return loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()
    end)
    if ok and type(lib) == "table" and type(lib.CreateWindow) == "function" then
        return lib
