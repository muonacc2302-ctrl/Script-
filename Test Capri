        return (k == "" or k == "NONE") and "H" or k
    end
    local function updateHKUI()
        if not LockHK.status or not LockHK.info or not LockHK.btn then return end
        local kName = getHKName()
        if LockHK.active and LockHK.target then
            LockHK.status.Text = "Locking: " .. LockHK.target.Name
            LockHK.status.TextColor3 = Color3.fromRGB(90, 255, 140)
            LockHK.info.Text = "Hotkey: " .. kName
            LockHK.btn.Text = "Unlock"
        else
