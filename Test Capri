            LockHK.status.TextColor3 = Color3.fromRGB(255, 95, 95)
            LockHK.info.Text = "Hotkey: " .. kName
            LockHK.btn.Text = "Start Lock"
        end
    end
    local function stopHK()
        LockHK.active = false
