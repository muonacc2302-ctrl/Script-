local lastAura = 0
local espDrawings = {}
getgenv().CapriESPDrawings = espDrawings

RunService.RenderStepped:Connect(function()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

    if myHum and myHum.Health > 0 and _G.Speed_Active then
        myHum.WalkSpeed = _G.WalkSpeedValue
    end

    local use360 = is360Mode()
    local circleRadius = getCircleRadius()
    local aimOn = isAnyPlayerAimEnabled()

    local center = _G.ShowZone
        and Vector2.new(ZoneDragButton.AbsolutePosition.X + ZoneDragButton.AbsoluteSize.X / 2, ZoneDragButton.AbsolutePosition.Y + ZoneDragButton.AbsoluteSize.Y / 2)
        or Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    if FOVCircle then
        pcall(function()
            FOVCircle.Visible = ((_G.ShowZone or aimOn or _G.SilentAim_NPC) and not use360) == true
            FOVCircle.Radius = circleRadius
            FOVCircle.Position = center
        end)
    end

    ZoneDragButton.Visible = _G.ShowZone and not use360
    AimBtn.BackgroundColor3 = aimOn and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(40, 40, 40)
    AimBtn.BackgroundTransparency = aimOn and 0.2 or 0.5
    CamBtn.BackgroundTransparency = getgenv().Capri.LockEnabled and 0.2 or 0.5

    local curTarget = getgenv().Capri.CurrentTarget
    if getgenv().Capri.LockEnabled and curTarget and curTarget.Parent then
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, curTarget.Position), _G.Smoothness or 0.15)
    end

    local shownLine = false
    if aimOn and curTarget and curTarget.Parent then
        local mdl = curTarget:FindFirstAncestorOfClass("Model")
        local plr = mdl and Players:GetPlayerFromCharacter(mdl)
        local hum = mdl and mdl:FindFirstChildOfClass("Humanoid")
        if plr and plr ~= LocalPlayer and hum and hum.Health > 0 then
            local pred = curTarget.Position + ((curTarget.AssemblyLinearVelocity or Vector3.zero) * (_G.PredictionStrength or 0.165))
            local sp, vis = Camera:WorldToViewportPoint(pred)
            if vis and SilentAimLine and SilentAimDot then
                pcall(function()
                    local endPt = Vector2.new(sp.X, sp.Y)
                    SilentAimLine.From = center
                    SilentAimLine.To = endPt
                    SilentAimLine.Visible = true
                    SilentAimDot.Position = endPt
                    SilentAimDot.Visible = true
                end)
                shownLine = true
            end
        end
    end
    if not shownLine then
        if SilentAimLine then pcall(function() SilentAimLine.Visible = false end) end
        if SilentAimDot then pcall(function() SilentAimDot.Visible = false end) end
    end

    -- Hitbox
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dMe = myRoot and (myRoot.Position - hrp.Position).Magnitude or 999
                if _G.SuperHB and dMe <= (_G.RenderDist or 600) then
                    local sz = _G.TruckHBSize or 80
                    hrp.Size = Vector3.new(sz, sz, sz); hrp.Transparency = 0.4; hrp.CanCollide = false
                elseif _G.HB and dMe <= (_G.RenderDist or 600) then
                    local alpha = math.clamp((dMe - 4) / 26, 0, 1)
                    local sz = (_G.MinHBSize or 4) + ((_G.MaxHBSize or 40) - (_G.MinHBSize or 4)) * alpha
                    hrp.Size = Vector3.new(sz, sz, sz); hrp.Transparency = 0.4; hrp.CanCollide = false
                else
                    hrp.Size = Vector3.new(2, 2, 1); hrp.Transparency = 1; hrp.CanCollide = false
                end
            end
        end
    end

    -- Kill Aura
    if _G.KA then
        if tick() - lastAura >= 2.0 then
            lastAura = tick()
            pcall(function()
                if not myRoot then return end
                local folder = Workspace:FindFirstChild("Enemies") or Workspace
                for _, obj in ipairs(folder:GetDescendants()) do
                    if obj:IsA("Model") and obj ~= myChar then
                        local hum = obj:FindFirstChildOfClass("Humanoid")
                        local hrp = obj:FindFirstChild("HumanoidRootPart")
                        if hum and hrp and hum.Health > 0 and (myRoot.Position - hrp.Position).Magnitude <= 100 then
                            if Players:GetPlayerFromCharacter(obj) == nil then
                                hum:TakeDamage(3387500)
                            else
                                local pn = obj.Name
                                if not getgenv().Capri.PlayerTimers[pn] then
                                    getgenv().Capri.PlayerTimers[pn] = tick()
                                elseif tick() - getgenv().Capri.PlayerTimers[pn] >= 1.0 then
                                    hum:TakeDamage(50)
                                    getgenv().Capri.PlayerTimers[pn] = tick()
                                end
                            end
                        end
                    end
                end
            end)
        end
    else
        getgenv().Capri.PlayerTimers = {}
    end

    -- ESP Drawing
    if _G.ESP then
        local active = {}
        local scrMid = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    local dObj = espDrawings[p]
                    if not dObj then
                        pcall(function()
                            local box = Drawing.new("Square")
                            box.Color = Color3.fromRGB(0, 255, 128); box.Thickness = 1.5; box.Filled = false
                            local nameTag = Drawing.new("Text")
                            nameTag.Color = Color3.new(1, 1, 1); nameTag.Size = 14; nameTag.Center = true; nameTag.Outline = true
                            local line = Drawing.new("Line")
                            line.Color = Color3.fromRGB(0, 255, 128); line.Thickness = 1; line.Transparency = 0.7
                            dObj = { box = box, name = nameTag, line = line }
                            espDrawings[p] = dObj
                        end)
                    end
                    if dObj then
                        active[p] = true
                        local sp, vis = Camera:WorldToViewportPoint(hrp.Position)
                        pcall(function()
                            if vis and sp.Z > 0 then
                                local sz = Vector2.new(2500 / sp.Z, 3500 / sp.Z)
                                dObj.box.Size = sz
                                dObj.box.Position = Vector2.new(sp.X - sz.X / 2, sp.Y - sz.Y / 2)
                                dObj.box.Visible = true
                                local distStr = myRoot and (" [" .. math.floor((myRoot.Position - hrp.Position).Magnitude) .. "m]") or ""
                                dObj.name.Text = p.Name .. " [" .. math.floor(hum.Health) .. " HP]" .. distStr
                                dObj.name.Position = Vector2.new(sp.X, sp.Y - sz.Y / 2 - 20)
                                dObj.name.Visible = true
                                dObj.line.From = scrMid
                                dObj.line.To = Vector2.new(sp.X, sp.Y)
                                dObj.line.Visible = true
                            else
                                dObj.box.Visible = false; dObj.name.Visible = false; dObj.line.Visible = false
                            end
                        end)
                    end
                end
            end
        end
        for p, o in pairs(espDrawings) do
            if not active[p] then
                pcall(function() o.box:Remove(); o.name:Remove(); o.line:Remove() end)
                espDrawings[p] = nil
            end
        end
    else
        for _, o in pairs(espDrawings) do
            pcall(function() o.box:Remove(); o.name:Remove(); o.line:Remove() end)
        end
        espDrawings = {}
        getgenv().CapriESPDrawings = espDrawings
    end
end)
