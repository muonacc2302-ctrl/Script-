task.spawn(function()
    while task.wait(0.1) do
        _G.FOV = _G.SuperZone_Active and 500 or 250
        local best, shortest = nil, (_G.Aim360 and _G.MaxDist or _G.FOV)
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local passPlayerFilter = getgenv().Capri and getgenv().Capri.PassPlayerAimFilter
        local aimPartName = _G.SilentAimPart or "Head"

        if root then
            local zoneCenter = _G.ShowZone
                and Vector2.new(ZoneDragButton.AbsolutePosition.X + ZoneDragButton.AbsoluteSize.X / 2, ZoneDragButton.AbsolutePosition.Y + ZoneDragButton.AbsoluteSize.Y / 2)
                or Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

            local playerAimRange = math.clamp(tonumber(_G.SilentAimPlayerRange) or 700, 0, 1000)

            -- 1. Mục tiêu người chơi cho Aim ẩn người chơi / Khóa camera người chơi
            if _G.SilentAimTargetPlayers and (_G.SilentAim_Player or _G.CamLock_Player) then
                local candidatePlayers = {}
                if _G.SilentAimMethod == "Chọn người chơi" and (_G.SilentAimSelectedPlayer or "") ~= "" then
                    local sel = Players:FindFirstChild(_G.SilentAimSelectedPlayer)
                    if sel then table.insert(candidatePlayers, sel) end
                else
                    for _, p in ipairs(Players:GetPlayers()) do
                        table.insert(candidatePlayers, p)
                    end
                end

                for _, p in ipairs(candidatePlayers) do
                    if p ~= LocalPlayer and p.Character and (not passPlayerFilter or passPlayerFilter(p)) then
                        local hum = p.Character:FindFirstChildOfClass("Humanoid")
                        local aimPart = p.Character:FindFirstChild(aimPartName) or p.Character:FindFirstChild("HumanoidRootPart")
                        if aimPart and hum and hum.Health > 0 then
                            local mag = (aimPart.Position - root.Position).Magnitude
                            if mag <= playerAimRange then
                                if _G.SilentAimMethod == "Chọn người chơi" then
                                    best = aimPart
                                    break
                                elseif _G.Aim360 then
                                    if mag < shortest then shortest, best = mag, aimPart end
                                else
                                    local sp, vis = Camera:WorldToViewportPoint(aimPart.Position)
                                    if vis then
                                        local sd = (Vector2.new(sp.X, sp.Y) - zoneCenter).Magnitude
                                        if sd <= _G.FOV and sd < shortest then shortest, best = sd, aimPart end
                                    end
                                end
                            end
                        end
                    end
                end
            end

            -- 2. Mục tiêu NPC / Quái chỉ dành riêng cho Aim ẩn NPC / Quái (Siêu Bá Khí)
            if not best and _G.SilentAim_NPC and Workspace:FindFirstChild("Enemies") then
                for _, e in ipairs(Workspace.Enemies:GetChildren()) do
                    local hPart = e:FindFirstChild(aimPartName) or e:FindFirstChild("HumanoidRootPart")
                    local hum = e:FindFirstChildOfClass("Humanoid")
                    if hPart and hum and hum.Health > 0 and Players:GetPlayerFromCharacter(e) == nil then
                        local mag = (hPart.Position - root.Position).Magnitude
                        if mag <= (_G.MaxDist or 700) then
                            if _G.Aim360 then
                                if mag < shortest then shortest, best = mag, hPart end
                            else
                                local sp, vis = Camera:WorldToViewportPoint(hPart.Position)
                                if vis then
                                    local sd = (Vector2.new(sp.X, sp.Y) - zoneCenter).Magnitude
                                    if sd <= _G.FOV and sd < shortest then shortest, best = sd, hPart end
                                end
                            end
                        end
                    end
                end
            end
        end
        getgenv().Capri.CurrentTarget = best
    end
end)
