    if type(data.ZoneBtnPos) == "table" then ZoneDragButton.Position = UDim2.new(unpack(data.ZoneBtnPos)) end
end

local function CollectCapriConfig()
    local payload = {}
    for k in pairs(CapriDefaults) do
        payload[k] = _G[k]
    end
    payload.CamBtnPos = { CamBtn.Position.X.Scale, CamBtn.Position.X.Offset, CamBtn.Position.Y.Scale, CamBtn.Position.Y.Offset }
    payload.AimBtnPos = { AimBtn.Position.X.Scale, AimBtn.Position.X.Offset, AimBtn.Position.Y.Scale, AimBtn.Position.Y.Offset }
    payload.JumpBtnPos = { JumpBtn.Position.X.Scale, JumpBtn.Position.X.Offset, JumpBtn.Position.Y.Scale, JumpBtn.Position.Y.Offset }
    payload.V4BtnPos = { V4Btn.Position.X.Scale, V4Btn.Position.X.Offset, V4Btn.Position.Y.Scale, V4Btn.Position.Y.Offset }
    payload.DashBtnPos = { DashBtn.Position.X.Scale, DashBtn.Position.X.Offset, DashBtn.Position.Y.Scale, DashBtn.Position.Y.Offset }
    payload.ZoneBtnPos = { ZoneDragButton.Position.X.Scale, ZoneDragButton.Position.X.Offset, ZoneDragButton.Position.Y.Scale, ZoneDragButton.Position.Y.Offset }
    return payload
end

local function SaveCapriConfig()
    if typeof(writefile) ~= "function" then return end
    pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(CollectCapriConfig()))
    end)
end

local function LoadCapriConfig()
    if typeof(isfile) ~= "function" or typeof(readfile) ~= "function" then return end
    local fileToUse = nil
    if isfile(CONFIG_FILE) then
        fileToUse = CONFIG_FILE
    elseif isfile(LEGACY_CAPRI_FILE) then
        fileToUse = LEGACY_CAPRI_FILE
    end
    if not fileToUse then return end

    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(fileToUse))
    end)
    if ok and type(decoded) == "table" then
        for k in pairs(CapriDefaults) do
            if decoded[k] ~= nil then
                _G[k] = decoded[k]
            end
        end
        applySavedButtonPositions(decoded)
    end
end

