local function setUIValue(key, value)
    local ctrl = uiControls[key]
    if ctrl and type(ctrl.Set) == "function" then
        ctrl._syncing = true
        pcall(function()
            ctrl:Set(value)
        end)
        ctrl._syncing = false
    end
