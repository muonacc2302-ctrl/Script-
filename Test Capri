    Tabs.ESP:Colorpicker({ Title = "Màu làm nổi bật", Default = hexToCol(_G.RJR_ESP_HighlightColor), Callback = function(c) saveCol("RJR_ESP_HighlightColor", c) end })
    Tabs.ESP:Divider()
    uiControls.RJR_ESP_Layout = Tabs.ESP:Dropdown({ Title = "Kiểu ESP", Values = { "Cổ điển", "Kiểu thanh máu" }, Value = _G.RJR_ESP_Layout, Callback = Bind("RJR_ESP_Layout") })
    uiControls.RJR_ESP_Avatar = Tabs.ESP:Toggle({ Title = "Hiện ảnh đại diện", Value = _G.RJR_ESP_Avatar, Callback = Bind("RJR_ESP_Avatar") })
