-- 1. FAST ATTACK MOBS & FAST ATTACK PLAYER
-- ==========================================
do
    local M1_RANGE = 500
    local Net = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Net")
    local RegisterAttack = Net:WaitForChild("RE/RegisterAttack")
    local RegisterHit = Net:WaitForChild("RE/RegisterHit")
    local RemoteSeed = Net:FindFirstChild("seed")
    local State = { FoundRemote = nil, FoundRemoteId = nil }

    task.spawn(function()
        local folders = {
            ReplicatedStorage:FindFirstChild("Util"),
            ReplicatedStorage:FindFirstChild("Common"),
            ReplicatedStorage:FindFirstChild("Remotes"),
            ReplicatedStorage:FindFirstChild("Assets"),
            ReplicatedStorage:FindFirstChild("FX"),
        }
        local function inspect(child)
            if child:IsA("RemoteEvent") and child:GetAttribute("Id") then
                State.FoundRemote = child
                State.FoundRemoteId = child:GetAttribute("Id")
            end
        end
        for _, folder in ipairs(folders) do
            if folder then
                for _, child in ipairs(folder:GetChildren()) do
                    inspect(child)
                end
                folder.ChildAdded:Connect(inspect)
            end
        end
    end)

    local function GetMobTargets()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local enemies = Workspace:FindFirstChild("Enemies")
        if not root or not enemies then return {} end

        local list = {}
        local myPos = root.Position
        for _, model in ipairs(enemies:GetChildren()) do
            local tRoot = model:FindFirstChild("HumanoidRootPart")
            local tHum = model:FindFirstChildOfClass("Humanoid")
            if tRoot and tHum and tHum.Health > 0 and not Players:GetPlayerFromCharacter(model) then
                if (tRoot.Position - myPos).Magnitude < M1_RANGE then
                    table.insert(list, {
                        Model = model,
                        Root = tRoot,
                        Head = model:FindFirstChild("Head") or tRoot,
                    })
                end
            end
        end
        return list
    end

    local function GetPlayerTargets()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return {} end

        local list = {}
        local myPos = root.Position
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local pChar = plr.Character
                local tRoot = pChar:FindFirstChild("HumanoidRootPart")
                local tHum = pChar:FindFirstChildOfClass("Humanoid")
                if tRoot and tHum and tHum.Health > 0 then
                    if (tRoot.Position - myPos).Magnitude < M1_RANGE then
                        table.insert(list, {
                            Model = pChar,
                            Root = tRoot,
                            Head = pChar:FindFirstChild("Head") or tRoot,
                        })
                    end
                end
            end
        end
        return list
    end

    local function SendHitBatch(targets, useEncrypted)
        if #targets == 0 then return end

        local hitList = {}
        for _, target in ipairs(targets) do
            table.insert(hitList, { target.Model, target.Root })
        end

        pcall(function()
            RegisterAttack:FireServer(0)
            RegisterHit:FireServer(targets[1].Head, hitList)
        end)

        if useEncrypted and State.FoundRemote and State.FoundRemoteId then
            pcall(function()
                local seedVal = RemoteSeed and RemoteSeed:InvokeServer() or 1
                local encId = bit32.bxor(State.FoundRemoteId + 909090, seedVal * 2)
                local rawName = "RE/RegisterHit"
                local shift = math.floor(Workspace:GetServerTimeNow() / 10 % 10) + 1
                local encName = string.gsub(rawName, ".", function(c)
                    return string.char(bit32.bxor(string.byte(c), shift))
                end)
                State.FoundRemote:FireServer(encName, encId, targets[1].Head, hitList)
            end)
        end
    end

    local function PerformAttackCycle(useEncrypted)
        local char = LocalPlayer.Character
        if not char then return end
        local hasTool = char:FindFirstChildOfClass("Tool") or char:FindFirstChild("EquippedWeapon")
        if not hasTool then return end

        if _G.FastAttackMobs then
            SendHitBatch(GetMobTargets(), useEncrypted)
        end
        if _G.FastAttackPlayer then
            SendHitBatch(GetPlayerTargets(), useEncrypted)
        end
    end

    task.spawn(function()
        while true do
            if not (_G.FastAttackMobs or _G.FastAttackPlayer) then
                task.wait(0.25)
                continue
            end
            local t0 = tick()
            pcall(PerformAttackCycle, _G.FastAttackMode ~= "Mode 1")
            task.wait(math.max(0.05 - (tick() - t0), 0.001))
        end
    end)

    uiControls.FastAttackMode = MainTab:Dropdown({
        Title = "Fast Attack Mode",
        Values = { "Mode 1", "Mode 2" },
        Value = _G.FastAttackMode,
        Callback = Bind("FastAttackMode"),
    })

    uiControls.FastAttackMobs = MainTab:Toggle({
        Title = "Fast Attack Mobs",
        Value = _G.FastAttackMobs,
        Callback = Bind("FastAttackMobs"),
    })

    uiControls.FastAttackPlayer = MainTab:Toggle({
        Title = "Fast Attack Player",
        Value = _G.FastAttackPlayer,
        Callback = Bind("FastAttackPlayer"),
    })
end

