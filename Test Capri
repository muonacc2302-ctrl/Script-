    end
    local function saveCol(key, col)
        _G[key] = string.format("%02X%02X%02X", math.floor(col.R * 255 + 0.5), math.floor(col.G * 255 + 0.5), math.floor(col.B * 255 + 0.5))
        SaveCapriConfig()
    end
    local function colToRgb(col)
        return string.format("rgb(%d,%d,%d)", math.floor(col.R * 255 + 0.5), math.floor(col.G * 255 + 0.5), math.floor(col.B * 255 + 0.5))
    end
    local function fmtBounty(n)
        n = tonumber(n) or 0
        return n >= 1000000 and string.format("%.1fM", n / 1000000) or string.format("%.1fK", n / 1000)
    end

    local espObjs = {}
    getgenv().CapriRJRESPObjs = espObjs
    local cache = {}
    local running = false

    local function removeOne(plr)
        local o = espObjs[plr]
        if o then
            pcall(function()
                if o.gui then o.gui:Destroy() end
                if o.highlight then o.highlight:Destroy() end
            end)
            espObjs[plr] = nil
        end
    end

    local function createOne(plr)
        if plr == LocalPlayer or not plr.Character then return end
        local head = plr.Character:FindFirstChild("Head")
        if not head then return end
        local bb = Instance.new("BillboardGui")
        bb.Adornee = head
        bb.Size = UDim2.new(0, 220, 0, 150)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        bb.Parent = head

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextSize = tonumber(_G.RJR_ESP_TextSize) or 14
