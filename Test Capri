    local function tickESP()
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer then continue end
            local char = plr.Character
            local head = char and char:FindFirstChild("Head")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not char or not head or not hum or not hrp or hum.Health <= 0 or hum.MaxHealth <= 0 then
                removeOne(plr)
                continue
            end
            local o = espObjs[plr]
            if not o or o.char ~= char or not o.gui.Parent then
                removeOne(plr)
                createOne(plr)
                o = espObjs[plr]
            end
            if not o then continue end

            local c = cache[plr]
            if not c or tick() - c.t > 5 then
                c = { lvl = "?", fruit = "Không có", bty = 0, team = "Không rõ", col = Color3.new(1, 1, 1), t = tick() }
                pcall(function() c.lvl = plr.Data.Level.Value end)
                pcall(function() c.fruit = plr.Data.DevilFruit.Value end)
                pcall(function() c.bty = plr.leaderstats["Bounty/Honor"].Value end)
                if plr.Team then
                    c.team = plr.Team.Name == "Marines" and "Hải quân" or "Hải tặc"
                    c.col = plr.Team.Name == "Marines" and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(255, 70, 70)
                end
                cache[plr] = c
            end

            local dist = math.floor((hrp.Position - myRoot.Position).Magnitude)
            local hpPct = math.floor((hum.Health / hum.MaxHealth) * 100)
            o.label.TextSize = tonumber(_G.RJR_ESP_TextSize) or 14

            local showBar = _G.RJR_ESP_Layout == "Kiểu thanh máu"
            o.bar.Visible = showBar
            if showBar then
                o.fill.Size = UDim2.new(math.clamp(hpPct / 100, 0, 1), 0, 1, 0)
                o.fill.BackgroundColor3 = hpPct > 50 and Color3.fromRGB(0, 255, 0) or (hpPct > 25 and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(255, 40, 40))
            end

            local showAv = _G.RJR_ESP_Avatar and o.avatar.Image ~= ""
            o.avatar.Visible = showAv
            if showAv then
                local isLeft = _G.RJR_ESP_AvatarSide == "Trái"
                o.avatar.AnchorPoint = Vector2.new(isLeft and 0 or 1, 0.5)
                o.avatar.Position = UDim2.new(isLeft and 0 or 1, isLeft and 4 or -4, 0.5, 0)
                o.label.AnchorPoint = Vector2.new(0.5, 0.5)
                o.label.Position = UDim2.new(0.5, isLeft and 18 or -18, 0.5, 0)
                o.label.Size = UDim2.new(1, -56, 1, 0)
            else
                o.label.AnchorPoint = Vector2.new(0, 0)
                o.label.Position = UDim2.new(0, 0, 0, 0)
                o.label.Size = UDim2.new(1, 0, 1, 0)
            end

            local lines = {}
            if _G.RJR_ESP_Name then
                table.insert(lines, "[" .. c.team .. "] <font color=\"" .. colToRgb(hexToCol(_G.RJR_ESP_NameColor)) .. "\">" .. plr.Name .. "</font>")
            end
            if _G.RJR_ESP_Level then
                table.insert(lines, "<font color=\"" .. colToRgb(hexToCol(_G.RJR_ESP_LevelColor)) .. "\">Lv." .. tostring(c.lvl) .. "</font>")
            end
            if _G.RJR_ESP_Fruit then
                table.insert(lines, "<font color=\"" .. colToRgb(hexToCol(_G.RJR_ESP_FruitColor)) .. "\">Trái: " .. tostring(c.fruit) .. "</font>")
            end
            if _G.RJR_ESP_Bounty then
                table.insert(lines, "<font color=\"" .. colToRgb(hexToCol(_G.RJR_ESP_BountyColor)) .. "\">Truy nã: " .. fmtBounty(c.bty) .. "</font>")
            end
            if _G.RJR_ESP_Distance then
                table.insert(lines, "<font color=\"" .. colToRgb(hexToCol(_G.RJR_ESP_DistanceColor)) .. "\">" .. tostring(dist) .. "m</font>")
            end
            if _G.RJR_ESP_HP and not showBar then
                table.insert(lines, "<font color=\"" .. colToRgb(hexToCol(_G.RJR_ESP_HPColor)) .. "\">Máu " .. tostring(hpPct) .. "%</font>")
            end
            o.label.Text = table.concat(lines, "\n")

            if _G.RJR_ESP_Highlight then
                local hc = hexToCol(_G.RJR_ESP_HighlightColor)
                if not o.highlight or not o.highlight.Parent then
                    local hl = Instance.new("Highlight")
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.FillTransparency = 0.5
                    hl.Parent = char
                    o.highlight = hl
                end
                o.highlight.FillColor = hc
                o.highlight.OutlineColor = hc
            elseif o.highlight then
                o.highlight:Destroy()
                o.highlight = nil
            end
        end
    end

    local function setRJRESP(on)
        running = on
        if on then
            for _, p in ipairs(Players:GetPlayers()) do createOne(p) end
            task.spawn(function()
                while running do
                    pcall(tickESP)
                    task.wait(0.1)
                end
            end)
        else
            for p in pairs(espObjs) do removeOne(p) end
        end
    end

